# ===== Общие =====
# Окружение: dev | prod
APP_ENV=dev
# HTTP-порт для локального запуска
HTTP_ADDR=:8080
# Префикс путей API (для API Gateway /v1)
HTTP_PREFIX=/v1

# ===== Логирование =====
LOG_LEVEL=debug

# ===== JWT =====
# Секрет для подписи access/refresh токенов (HS256). В prod — из YC Secret/настроек.
JWT_SECRET=change-me
# Время жизни токенов (секунды)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ===== YDB Serverless =====
# Полный путь базы, например: /ru-central1/b1g.../etn...
YDB_DATABASE=
# Endpoint: grpcs://ydb.serverless.yandexcloud.net:2135
YDB_ENDPOINT=

# ===== Yandex Cloud: сервисный аккаунт =====
# Авторизация: либо путь к файлу ключа SA (формат YC), либо IAM-токен, либо env YC_SERVICE_ACCOUNT_KEY_FILE.
YC_FOLDER_ID=
# Учётные данные Object Storage (S3-совместимо, статические ключи SA)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ===== YMQ =====
YMQ_QUEUE_URL=
